{
  "redirects": [
    { "source": "/", "destination": "/agrolink/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/agrolink/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/agrolink/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/agrolink/:path*", "destination": "/index.html" }
  ]
}